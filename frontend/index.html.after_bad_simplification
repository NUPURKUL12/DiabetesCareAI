/* bar chart: props items [{l,v}] */
function renderBars(el,items,out){const W=560,H=240,L=40,B=34,T=10,bw=(W-L)/items.length,mx=Math.max(...items.map(i=>i.v)),sy=v=>H-B-(v/mx)*(H-B-T-6);
let h=`<defs><linearGradient id="gb" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#22d3ee"/><stop offset="1" stop-color="#14b8a6" stop-opacity=".6"/></linearGradient></defs>`;
[0,.5,1].forEach(f=>{const v=Math.round(mx*f),y=sy(v);h+=`<line class="ax" x1="${L}" x2="${W}" y1="${y}" y2="${y}"/><text x="${L-6}" y="${y+4}" text-anchor="end">${v}%</text>`});
items.forEach((it,i)=>{const x=L+i*bw+5,y=sy(it.v);h+=`<rect class="bar" tabindex="0" data-i="${i}" x="${x}" width="${bw-10}" y="${H-B}" height="0" rx="4"><animate attributeName="y" from="${H-B}" to="${y}" dur=".6s" begin="${i*.04}s" fill="freeze"/><animate attributeName="height" from="0" to="${H-B-y}" dur=".6s" begin="${i*.04}s" fill="freeze"/></rect><text x="${x+(bw-10)/2}" y="${H-B+15}" text-anchor="middle" style="font-size:9px">${it.l}</text>`});
h+=`<text x="${L+(W-L)/2}" y="${H-2}" text-anchor="middle">Model score band</text><text transform="rotate(-90)" x="${-(H-B)/2}" y="11" text-anchor="middle">Share of records (%)</text>`;
el.innerHTML=svg(h,`0 0 ${W} ${H}`);
el.querySelectorAll('.bar').forEach(b=>{const it=items[+b.dataset.i];bindTip(b,'Score '+it.l,`${it.v}% of demo records fall in this band.`);b.onclick=()=>{el.querySelectorAll('.bar').forEach(x=>x.classList.remove('sel'));b.classList.add('sel');out.innerHTML=`<b>Score ${it.l}</b>: ${it.v}% of demo records. Illustrative only.`}})}
renderBars($('#bars'),api.getDist(),$('#bd'));

/* line chart: props {months,series}, toggles + range */
function lineChart(el,leg,seg,out,{months,series}){const st={on:new Set(series.map(s=>s.id)),n:12};
const draw=()=>{const W=600,H=250,L=46,B=30,T=12,R=12,ms=months.slice(-st.n),k=ms.length,sx=i=>L+i*(W-L-R)/(k-1);let h='';
[0,.25,.5,.75,1].forEach(f=>{const y=T+f*(H-B-T);h+=`<line class="ax" x1="${L}" x2="${W-R}" y1="${y}" y2="${y}"/><text x="${L-6}" y="${y+4}" text-anchor="end">${Math.round((1-f)*100)}%</text>`});
ms.forEach((m,i)=>h+=`<text x="${sx(i)}" y="${H-12}" text-anchor="middle">${m}</text>`);
h+=`<text x="${L+(W-L-R)/2}" y="${H}" text-anchor="middle">Month (demo)</text><text transform="rotate(-90)" x="${-(H-B)/2}" y="11" text-anchor="middle">Share of each series’ own range</text>`;
series.filter(s=>st.on.has(s.id)).forEach(s=>{const v=s.v.slice(-k),lo=Math.min(...s.v),hi=Math.max(...s.v),sy=x=>T+(1-(x-lo)/(hi-lo||1))*(H-B-T);
h+=`<path d="${v.map((x,i)=>(i?'L':'M')+sx(i)+' '+sy(x)).join('')}" fill="none" stroke="${s.color}" stroke-width="2.4" stroke-linejoin="round"/>`+v.map((x,i)=>`<circle class="pt" tabindex="0" data-s="${s.id}" data-i="${i}" cx="${sx(i)}" cy="${sy(x)}" r="4.5" fill="${s.color}" stroke="#050b1a" stroke-width="2"/>`).join('')});
el.innerHTML=svg(h,`0 0 ${W} ${H}`);
el.querySelectorAll('.pt').forEach(p=>{const s=series.find(x=>x.id===p.dataset.s),i=+p.dataset.i,val=s.v.slice(-k)[i];bindTip(p,s.name,`${ms[i]}: <b style="display:inline;color:#e8f1ff">${val}</b> ${s.unit}. Demo value.`);p.onclick=()=>out.innerHTML=`<b>${s.name}, ${ms[i]}</b>: ${val} ${s.unit}. Illustrative only. Each line is scaled to its own range so shapes are comparable; hover for real values.`})};
leg.innerHTML=series.map(s=>`<button aria-pressed="true" data-id="${s.id}"><i style="background:${s.color}"></i>${s.name}</button>`).join('');
leg.onclick=e=>{const b=e.target.closest('button');if(!b)return;const on=st.on.has(b.dataset.id);if(on&&st.on.size===1)return;on?st.on.delete(b.dataset.id):st.on.add(b.dataset.id);b.setAttribute('aria-pressed',!on);hideTip();draw()};
seg.innerHTML=[[3,'3 months'],[6,'6 months'],[12,'12 months']].map(r=>`<button aria-pressed="${r[0]===12}" data-n="${r[0]}">${r[1]}</button>`).join('');
seg.onclick=e=>{const b=e.target.closest('button');if(!b)return;st.n=+b.dataset.n;seg.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b));hideTip();draw()};draw()}
const tr=api.getTrend();lineChart($('#line'),$('#leg'),$('#seg'),$('#ld'),tr);

/* sortable table: props rows */
function table(rows){const cols=['Indicator','Source type','Demo weight','Demo pattern'];let sk=2,dir=-1;
$('#tbl thead').innerHTML='<tr>'+cols.map((c,i)=>`<th scope="col" aria-sort="none"><button data-k="${i}">${c}</button></th>`).join('')+'</tr>';
const draw=()=>{const r=[...rows].sort((a,b)=>(a[sk]>b[sk]?1:-1)*dir);$('#tbl tbody').innerHTML=r.map(x=>`<tr><td>${x[0]}</td><td>${x[1]}</td><td>${x[2].toFixed(2)}</td><td>${x[3]}</td></tr>`).join('');
document.querySelectorAll('#tbl th').forEach((t,i)=>t.setAttribute('aria-sort',i===sk?(dir>0?'ascending':'descending'):'none'))};
$('#tbl thead').onclick=e=>{const b=e.target.closest('button');if(!b)return;const k=+b.dataset.k;dir=k===sk?-dir:1;sk=k;draw()};draw()}
table(api.getTable());

/* workflow */
const fl=$('#flow');fl.innerHTML=DATA.flow.map((f,i)=>`<button class="node" role="tab" aria-selected="${i===3}" data-i="${i}"><span>${i+1}</span>${f[0]}</button>`).join('');
const pick=i=>{fl.querySelectorAll('.node').forEach((n,j)=>n.setAttribute('aria-selected',i===j));$('#fp').innerHTML=`<h3>${DATA.flow[i][0]}</h3><p class="mut" style="margin-top:8px">${DATA.flow[i][1]}</p>`};
fl.onclick=e=>{const n=e.target.closest('.node');if(n)pick(+n.dataset.i)};
fl.onkeydown=e=>{const c=+document.activeElement.dataset.i;if(isNaN(c))return;let n=c;if(e.key==='ArrowRight')n=Math.min(4,c+1);if(e.key==='ArrowLeft')n=Math.max(0,c-1);if(n!==c){e.preventDefault();pick(n);fl.children[n].focus()}};
pick(3);

/* Live model API integration */
(() => {
  const API_BASE = 'http://127.0.0.1:8765';

  const readmissionNumeric = new Set([
    'admission_type_id','discharge_disposition_id','admission_source_id',
    'time_in_hospital','num_lab_procedures','num_procedures','num_medications',
    'number_outpatient','number_emergency','number_inpatient','number_diagnoses'
  ]);
  const cdcNumeric = new Set([
    'HighBP','HighChol','CholCheck','BMI','Smoker','Stroke',
    'HeartDiseaseorAttack','PhysActivity','Fruits','Veggies',
    'HvyAlcoholConsump','AnyHealthcare','NoDocbcCost','GenHlth',
    'MentHlth','PhysHlth','DiffWalk','Sex','Age','Education','Income'
  ]);

  function formPayload(form, numericFields) {
    const payload = {};
    for (const [key, value] of new FormData(form).entries()) {
      payload[key] = numericFields.has(key) ? Number(value) : value;
    }
    return payload;
  }

  function setStatus(node, message, state = '') {
    node.textContent = message;
    node.dataset.state = state;
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, ch => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    })[ch]);
  }

  function showResult(node, heading, score, details, warning) {
    node.hidden = false;
    node.replaceChildren();

    const title = document.createElement('h4');
    title.textContent = heading;
    node.appendChild(title);

    const scoreNode = document.createElement('div');
    scoreNode.className = 'dc-score';
    scoreNode.textContent = score;
    node.appendChild(scoreNode);

    const detailNode = document.createElement('p');
    detailNode.textContent = details;
    node.appendChild(detailNode);

    const warningNode = document.createElement('p');
    warningNode.textContent = warning;
    node.appendChild(warningNode);
  }

  async function submitPrediction({formId, statusId, resultId, endpoint, numericFields, kind}) {
    const form = document.getElementById(formId);
    const status = document.getElementById(statusId);
    const result = document.getElementById(resultId);
    if (!form || !status || !result) return;

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const button = form.querySelector('button[type="submit"]');
      const oldText = button.textContent;
      button.disabled = true;
      button.textContent = 'Running model?';
      result.hidden = true;
      setStatus(status, 'Sending inputs to the local prediction API?');

      try {
        const response = await fetch(API_BASE + endpoint, {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify(formPayload(form, numericFields))
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || `Request failed (HTTP ${response.status}).`);
        }

        if (typeof data.predicted_score !== 'number') {
          throw new Error('The API response did not contain a numeric predicted_score.');
        }

        const pct = (data.predicted_score * 100).toFixed(1) + '%';
        if (kind === 'readmission') {
          showResult(
            result,
            'Readmission model result',
            pct,
            `Risk tier: ${data.risk_tier}. This is the model's score for historical readmission within 30 days; it is not a calibrated clinical probability.`,
            data.warning || 'Research prototype; external validation is required.'
          );
        } else {
          const classText = data.class_meaning?.[String(data.predicted_class)] || `Survey target class ${data.predicted_class}`;
          showResult(
            result,
            'CDC survey classifier result',
            pct,
            `Predicted class: ${data.predicted_class} ? ${classText}. Classification threshold: ${data.threshold}. This is not a diagnosis or a forecast of future onset.`,
            data.warning || 'Research classifier; external validation is required.'
          );
        }

        const raw = document.createElement('details');
        raw.style.marginTop = '12px';
        const summary = document.createElement('summary');
        summary.textContent = 'View raw API response';
        summary.style.cursor = 'pointer';
        const pre = document.createElement('pre');
        pre.textContent = JSON.stringify(data, null, 2);
        raw.append(summary, pre);
        result.appendChild(raw);

        setStatus(status, 'Prediction received successfully.', 'success');
      } catch (error) {
        result.hidden = false;
        result.replaceChildren();
        const title = document.createElement('h4');
        title.textContent = 'Unable to run prediction';
        const message = document.createElement('p');
        message.textContent = error.message || 'Unexpected error.';
        const hint = document.createElement('p');
        hint.textContent = 'Check that api_server.py is running at http://127.0.0.1:8765 and that the browser can reach it.';
        result.append(title, message, hint);
        setStatus(status, 'Prediction failed. See the message below.', 'error');
      } finally {
        button.disabled = false;
        button.textContent = oldText;
      }
    });
  }

  submitPrediction({
    formId:'readmission-form',
    statusId:'readmission-status',
    resultId:'readmission-result',
    endpoint:'/api/readmission',
    numericFields:readmissionNumeric,
    kind:'readmission'
  });

  submitPrediction({
    formId:'diabetes-form',
    statusId:'diabetes-status',
    resultId:'diabetes-result',
    endpoint:'/api/diabetes-status',
    numericFields:cdcNumeric,
    kind:'diabetes'
  });
})();


// Real API dashboard, retrospective worklist and intervention tracker.
(() => {
  const API = 'http://127.0.0.1:8765';
  const $ = (id) => document.getElementById(id);
  const escapeHTML = (value) => String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
  }[ch]));
  const pct = (value) => Number.isFinite(Number(value)) ? `${(Number(value) * 100).toFixed(1)}%` : '?';
  const num = (value) => Number.isFinite(Number(value)) ? Number(value).toLocaleString() : '?';
  const metric = (label, value) =>
    `<div class="api-stat"><div class="value">${escapeHTML(value)}</div><div class="label">${escapeHTML(label)}</div></div>`;
  const setStatus = (id, message, type='') => {
    const node = $(id);
    if (!node) return;
    node.textContent = message;
    node.className = `api-status ${type}`.trim();
  };
  async function getJSON(url) {
    const response = await fetch(`${API}${url}`);
    const data = await response.json();
    if (!response.ok || data.status === 'error') throw new Error(data.message || `Request failed (${response.status})`);
    return data;
  }

  async function loadMetrics() {
    try {
      const data = await getJSON('/api/metrics');
      const r = data.readmission;
      const rm = r.metrics;
      const d = data.diabetes_status;
      const dm = d.metrics;

      $('api-model-metrics').innerHTML = `
        <h4 style="margin-top:18px">Hospital readmission model</h4>
        <p class="api-note">${escapeHTML(r.task)} ? ${escapeHTML(r.dataset)} ? ${escapeHTML(r.evaluation)}</p>
        <div class="api-grid">
          ${metric('Test accuracy', pct(rm.test_accuracy))}
          ${metric('Test precision', pct(rm.test_precision))}
          ${metric('Test recall', pct(rm.test_recall))}
          ${metric('Test F1', pct(rm.test_f1))}
          ${metric('Test ROC-AUC', Number(rm.test_roc_auc).toFixed(3))}
          ${metric('Average precision', Number(rm.test_average_precision).toFixed(3))}
          ${metric('Test encounters', num(rm.test_encounters))}
          ${metric('Distinct patients', num(rm.test_distinct_patients))}
        </div>
        <p class="api-note">Confusion matrix (TN / FP / FN / TP): ${rm.test_confusion_matrix_tn_fp_fn_tp.map(num).join(' / ')}. Decision threshold selected on validation data: ${Number(rm.threshold_selected_on_validation).toFixed(3)}.</p>
        <p class="api-note">${escapeHTML(rm.warning)}</p>
        <h4 style="margin-top:22px">CDC survey diabetes-status classifier</h4>
        <p class="api-note">${escapeHTML(d.task)} ? ${escapeHTML(d.dataset)} ? ${escapeHTML(d.evaluation)}</p>
        <div class="api-grid">
          ${metric('Test accuracy', pct(dm.test_accuracy))}
          ${metric('Test precision', pct(dm.test_precision))}
          ${metric('Test recall', pct(dm.test_recall))}
          ${metric('Test F1', pct(dm.test_f1))}
          ${metric('Test ROC-AUC', Number(dm.test_roc_auc).toFixed(3))}
          ${metric('Average precision', Number(dm.test_average_precision).toFixed(3))}
          ${metric('Test records', num(dm.split.test))}
          ${metric('Dataset records', num(dm.dataset_records))}
        </div>
        <p class="api-note">Confusion matrix: TN ${num(dm.test_confusion_matrix[0][0])}, FP ${num(dm.test_confusion_matrix[0][1])}, FN ${num(dm.test_confusion_matrix[1][0])}, TP ${num(dm.test_confusion_matrix[1][1])}. Validation-selected threshold: ${Number(dm.threshold_selected_on_validation).toFixed(3)}.</p>
        <p class="api-note">${escapeHTML(dm.warning)}</p>`;

      const tiers = r.risk_tiers.test_results_by_tier;
      $('api-tier-results').innerHTML = `
        <div class="api-table-wrap"><table class="api-table">
          <thead><tr><th>Risk tier</th><th>Encounters</th><th>Mean model score</th><th>Observed readmission rate</th><th>Observed readmissions</th></tr></thead>
          <tbody>${tiers.map(t => `<tr>
            <td><span class="api-tier">${escapeHTML(t.risk_tier)}</span></td>
            <td>${num(t.encounters)}</td><td>${pct(t.mean_predicted_probability)}</td>
            <td>${pct(t.observed_readmission_rate)}</td><td>${num(t.actual_readmissions)}</td>
          </tr>`).join('')}</tbody>
        </table></div>
        <p class="api-note">Tier boundaries were derived from validation-set score tertiles: Low/Medium ${Number(r.risk_tiers.validation_cutoffs.low_to_medium).toFixed(3)}; Medium/High ${Number(r.risk_tiers.validation_cutoffs.medium_to_high).toFixed(3)}. These are research groupings, not medical decision rules.</p>`;

      $('api-data-coverage').innerHTML = `
        <div class="api-coverage">${data.data_coverage.map(item => `
          <div class="api-coverage-item"><strong>${escapeHTML(item.category)}</strong>
            <span>${escapeHTML(item.status)}</span><div class="api-note">${escapeHTML(item.details)}</div>
          </div>`).join('')}</div>
        <h4 style="margin-top:20px">Integration limitations</h4>
        <ul class="api-note">${data.integration_limitations.map(item => `<li>${escapeHTML(item)}</li>`).join('')}</ul>`;
      setStatus('api-dashboard-status', 'Live metrics loaded from the local API.', 'success');
    } catch (error) {
      setStatus('api-dashboard-status', `Could not load metrics: ${error.message}`, 'error');
    }
  }

  const PAGE_SIZE = 20;
  let worklistOffset = 0;
  let worklistTotal = 0;
  let worklistRecords = [];
  let interventionRecords = {};

  async function loadInterventions() {
    const data = await getJSON('/api/interventions');
    interventionRecords = data.records || {};
    renderInterventions();
    return data;
  }

  function renderInterventions() {
    const entries = Object.values(interventionRecords);
    $('intervention-summary').textContent = `${entries.length} saved intervention record(s).`;
    if (!entries.length) {
      $('intervention-table').innerHTML = '<p class="api-note">No intervention records saved yet. Use the worklist editor to add one.</p>';
      return;
    }
    $('intervention-table').innerHTML = `<table class="api-table">
      <thead><tr><th>Worklist reference</th><th>Status</th><th>Follow-up date</th><th>Notes</th><th>Last updated</th></tr></thead>
      <tbody>${entries.map(item => `<tr>
        <td>${escapeHTML(item.worklist_reference)}</td><td>${escapeHTML(item.status)}</td>
        <td>${escapeHTML(item.follow_up_date || '?')}</td><td>${escapeHTML(item.notes || '?')}</td>
        <td>${escapeHTML(item.updated_at || '?')}</td>
      </tr>`).join('')}</tbody></table>`;
  }

  function interventionEditor(record) {
    const saved = interventionRecords[record.worklist_reference] || {};
    const status = saved.status || 'Not reviewed';
    return `<form class="api-intervention" data-intervention-form="${escapeHTML(record.worklist_reference)}">
      <select name="status" aria-label="Intervention status">
        ${['Not reviewed','Reviewed','Follow-up planned','Completed'].map(s => `<option ${s === status ? 'selected' : ''}>${s}</option>`).join('')}
      </select>
      <input name="follow_up_date" type="date" aria-label="Follow-up date" value="${escapeHTML(saved.follow_up_date || '')}">
      <textarea name="notes" aria-label="Intervention notes" placeholder="Add follow-up notes?">${escapeHTML(saved.notes || '')}</textarea>
      <button class="btn p" type="submit">Save update</button>
    </form>`;
  }

  async function loadWorklist() {
    setStatus('worklist-status', 'Loading worklist?');
    const tier = $('worklist-tier').value;
    const search = $('worklist-search').value.trim();
    const params = new URLSearchParams({limit:String(PAGE_SIZE), offset:String(worklistOffset)});
    if (tier !== 'All') params.set('risk_tier', tier);
    if (search) params.set('q', search);

    try {
      const data = await getJSON(`/api/worklist?${params.toString()}`);
      worklistRecords = data.records || [];
      worklistTotal = data.total || 0;
      $('worklist-summary').textContent =
        `${num(worklistTotal)} matching encounters ? All tiers: High ${num(data.tier_counts.High)}, Medium ${num(data.tier_counts.Medium)}, Low ${num(data.tier_counts.Low)}.`;
      $('worklist-table').innerHTML = worklistRecords.length ? `
        <table class="api-table">
          <thead><tr><th>Reference / priority</th><th>Model score / tier</th><th>Age group</th><th>Stay</th><th>Prior visits (outpatient / emergency / inpatient)</th><th>Labs / procedures / medications</th><th>Diagnoses</th><th>Glucose / A1C</th><th>Intervention update</th></tr></thead>
          <tbody>${worklistRecords.map(record => `<tr>
            <td><strong>${escapeHTML(record.worklist_reference)}</strong><br><span class="api-small">${escapeHTML(record.priority)}</span></td>
            <td>${pct(record.predicted_score)}<br><span class="api-tier">${escapeHTML(record.risk_tier)}</span></td>
            <td>${escapeHTML(record.age_group)}</td>
            <td>${num(record.length_of_stay_days)} days</td>
            <td>${num(record.prior_outpatient_visits)} / ${num(record.prior_emergency_visits)} / ${num(record.prior_inpatient_visits)}</td>
            <td>${num(record.lab_procedures)} / ${num(record.procedures)} / ${num(record.medication_count)}</td>
            <td>${num(record.diagnosis_count)}</td>
            <td>${escapeHTML(record.max_glucose_result)} / ${escapeHTML(record.a1c_result)}</td>
            <td>${interventionEditor(record)}</td>
          </tr>`).join('')}</tbody>
        </table>` : '<p class="api-note">No matching encounters found.</p>';
      $('worklist-page').textContent = `Showing ${worklistRecords.length ? worklistOffset + 1 : 0}?${Math.min(worklistOffset + worklistRecords.length, worklistTotal)} of ${num(worklistTotal)}`;
      $('worklist-prev').disabled = worklistOffset <= 0;
      $('worklist-next').disabled = worklistOffset + PAGE_SIZE >= worklistTotal;
      setStatus('worklist-status', data.warning || 'Worklist loaded.', 'success');
    } catch (error) {
      $('worklist-table').replaceChildren();
      setStatus('worklist-status', `Could not load worklist: ${error.message}`, 'error');
    }
  }

  $('worklist-tier').addEventListener('change', () => { worklistOffset = 0; loadWorklist(); });
  $('worklist-search').addEventListener('input', () => {
    clearTimeout(window.__worklistSearchTimer);
    window.__worklistSearchTimer = setTimeout(() => { worklistOffset = 0; loadWorklist(); }, 300);
  });
  $('worklist-refresh').addEventListener('click', () => { loadWorklist(); loadInterventions().catch(() => {}); });
  $('worklist-prev').addEventListener('click', () => { worklistOffset = Math.max(0, worklistOffset - PAGE_SIZE); loadWorklist(); });
  $('worklist-next').addEventListener('click', () => {
    if (worklistOffset + PAGE_SIZE < worklistTotal) { worklistOffset += PAGE_SIZE; loadWorklist(); }
  });

  $('worklist-table').addEventListener('submit', async (event) => {
    const form = event.target.closest('[data-intervention-form]');
    if (!form) return;
    event.preventDefault();
    const reference = form.dataset.interventionForm;
    const formData = new FormData(form);
    const body = {
      worklist_reference: reference,
      status: formData.get('status'),
      follow_up_date: formData.get('follow_up_date') || '',
      notes: formData.get('notes') || ''
    };
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    try {
      const response = await fetch(`${API}/api/interventions`, {
        method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)
      });
      const data = await response.json();
      if (!response.ok || data.status === 'error') throw new Error(data.message || 'Save failed.');
      setStatus('intervention-status', `Saved intervention for ${reference}.`, 'success');
      await loadInterventions();
      await loadWorklist();
    } catch (error) {
      setStatus('intervention-status', `Could not save update: ${error.message}`, 'error');
    } finally {
      button.disabled = false;
    }
  });

  loadMetrics();
  loadInterventions().catch(error => setStatus('intervention-status', error.message, 'error'));
  loadWorklist();
})();

</script>
